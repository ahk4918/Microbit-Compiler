{
  "name": "Microbit-Compiler",
  "version": "1.0.0",
  "description": "Full Compiler GUI with support for building TS (Makecode), Python and C++ (CODAL) code for Micro:bit",
  "homepage": "https://github.com",
  "author": {
    "name": "Akhilesh Gollapudi",
    "email": "akhilesh.gollapudi@outlook.com"
  },
  "main": "./gui/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:all": "electron-builder --linux --windows --mac --publish always",
    "dist:linux:debian": "electron-builder --linux deb --publish always",
    "dist:linux:fedora": "electron-builder --linux rpm --publish always",
    "dist:linux:tar": "electron-builder --linux tar.gz --publish always",
    "dist:win": "electron-builder --windows --publish always",
    "dist:mac": "electron-builder --mac --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "electron-log": "^5.2.4"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.compiler.microbit",
    "productName": "Micro:bit Compiler",
    "extraResources": [
      {
        "from": "buildengine/MPython/compilerVenv-x64/",
        "to": "resources/compilerVenv/x64/",
        "filter": ["**/*"]
      },
      {
        "from": "buildengine/MPython/compilerVenv-arm64/",
        "to": "resources/compilerVenv/arm64/",
        "filter": ["**/*"]
      },
      {
        "from": "buildengine/C++/toolchain/arm-gcc-x64/",
        "to": "resources/toolchain/x64/",
        "filter": ["**/*"]
      },
      {
        "from": "buildengine/C++/toolchain/arm-gcc-arm64/",
        "to": "resources/toolchain/arm64/",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "pkg",
          "arch": "universal"
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    }
  }
}