{
  "name": "Microbit-Compiler",
  "version": "1.0.0",
  "description": "Full Compiler GUI with support for building TS (Makecode), Python and C++ (CODAL) code for Micro:bit",
  "homepage": "https://github.com",
  "author": {
    "name": "Akhilesh Gollapudi",
    "email": "akhilesh.gollapudi@outlook.com"
  },
  "main": "./gui/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:all": "electron-builder --linux --windows --mac",
    "dist:linux:debian": "electron-builder --linux deb",
    "dist:linux:fedora": "electron-builder --linux rpm",
    "dist:linux:tar": "electron-builder --linux tar.gz",
    "dist:win": "electron-builder --windows",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "electron-log": "^5.2.4"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.compiler.microbit",
    "productName": "Micro:bit Compiler",
    "copyright": "Copyright © 2026 Akhilesh Gollapudi",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "gui/**/*",
      "buildengine/**/*",
      "assets/**/*",
      "package.json",
      "compiler.js",
      "flash.js"
    ],
    "extraResources": [
      {
        "from": "buildengine/MPython/compilerVenv/",
        "to": "resources/compilerVenv/",
        "filter": [ "**/*" ]
      },
      {
        "from": "buildengine/C++/toolchain/arm-gcc/",
        "to": "resources/toolchain/",
        "filter": [ "**/*" ]
      }
    ],
    "asar": false,
    "asarUnpack": [
      "**/*.{node,dll,exe,so,dylib}",
      "resources/**"
    ],
    "icon": "assets/icon.png",
    "publish": {
      "provider": "github",
      "owner": "ahk4918",
      "repo": "microbit-compiler"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "pkg",
          "arch": "universal"
        }
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "linux": {
        "target": [ "deb", "rpm", "tar.gz" ],
        "icon": "assets/icon.png",
        "category": "Development",
        "maintainer": "Akhilesh Gollapudi <akhilesh.gollapudi@outlook.com>",
        "executableName": "microbit-compiler",
        "desktop": {
          "entry": {
            "Name": "Micro:bit Compiler",
            "Comment": "Compile code for Micro:bit devices",
            "Terminal": "false",
            "Type": "Application",
            "Categories": "Development;IDE;"
          }
        }
      },
      "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createStartMenuShortcut": true,
      "shortcutName": "Micro:bit Compiler"
    }
  }
}
